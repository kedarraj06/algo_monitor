# MongoDB configuration (Static Scans & NFT Certificates DB)
MONGODB_URL=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/
MONGODB_DB_NAME=algoshield

# FastAPI server settings
PORT=8000
HOST=0.0.0.0

# Vector store and model directories (Standardized absolute or relative-to-root paths)
VECTORSTORE_DIR=model/vectorstore
SLM_MODEL_DIR=model/slm

# Supabase configuration (Real-time 24/7 Monitoring DB)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Algorand configuration (Mainnet or Testnet indices/wallets)
INDEXER_API_URL=https://mainnet-idx.algonode.cloud
PLATFORM_MNEMONIC=your twenty five word mnemonic phrase here for minting certificates

# SMTP Email Alert Service configurations
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_smtp_app_password_here

# Telegram Alert Service configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
